{
  "rewrites": [
    { "source": "/api/download/android", "destination": "/downloads/moon-fitness.apk" }
  ],
  "headers": [
    {
      "source": "/(downloads/moon-fitness.apk|api/download/android)",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"moon-fitness.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
