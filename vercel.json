{
  "rewrites": [
    { "source": "/api/download/android", "destination": "/downloads/moon-fitness.apk" },
    { "source": "/api/auth/admin-override", "destination": "/api/auth.py" },
    { "source": "/api/auth/:path*", "destination": "/api/auth.py" },
    { "source": "/api/coach-chat", "destination": "/api/coach_chat.py" },
    { "source": "/api/distribution", "destination": "/api/distribution.py" },
    { "source": "/api/leaderboard", "destination": "/api/leaderboard.py" },
    { "source": "/api/users", "destination": "/api/users.py" }
  ],
  "headers": [
    {
      "source": "/(downloads/moon-fitness.apk|api/download/android)",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"moon-fitness.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
